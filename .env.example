# Variables à définir dans Vercel (Settings → Environment Variables). Ne commitez jamais les vraies valeurs.

# --- Accès au site ---
APP_USER=admin
# php -r 'echo password_hash("votre-mot-de-passe-long", PASSWORD_DEFAULT), PHP_EOL;'
APP_PASSWORD_HASH=
# openssl rand -hex 32
APP_SECRET=
CRON_SECRET=

# --- Base MySQL accessible à distance ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_SSL=1
# Facultatif : contenu PEM du certificat racine de l'hébergeur (ex. Aiven)
DB_SSL_CA=

# --- DHIS2 ---
DHIS2_BASE_URL=https://votre-instance.example.org
# Recommandé : jeton d'accès personnel d'un compte en lecture seule
DHIS2_TOKEN=
# Sinon :
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_DATASET_UID=
DHIS2_NIVEAU_COMMUNE=4

# Requêtes simultanées par instance PHP
PHP_CLI_SERVER_WORKERS=4
